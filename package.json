{
  "name": "@dharmax/context-manager",
  "version": "0.3.0",
  "description": "Prompt context attention manager with Semantika-backed semantic discovery, priority budgeting, and non-destructive compression.",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src",
    "dist",
    "README.md"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit",
    "build": "rm -rf dist && bun build src/index.ts --outdir dist --target bun --format esm && bunx tsc --noEmit false --declaration --emitDeclarationOnly --outDir dist"
  },
  "keywords": [
    "llm",
    "context",
    "semantika",
    "rag",
    "token-budgeting",
    "compression"
  ],
  "author": "dharmax",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dharmax/context-manager.git"
  },
  "bugs": {
    "url": "https://github.com/dharmax/context-manager/issues"
  },
  "homepage": "https://github.com/dharmax/context-manager#readme",
  "engines": {
    "bun": ">=1.3.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "latest"
  },
  "packageManager": "bun@latest"
}
